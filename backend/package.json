{
  "name": "eduud-backend",
  "version": "0.1.0",
  "description": "E-Duud дуудлага худалдааны API",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -T src/main.ts",
    "deploy:start": "prisma migrate deploy && node dist/main.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node -T prisma/seed.ts",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
