generator client {
  provider = "prisma-client-js"
  // Хоёр орчинд хоёуланд нь ажиллана: Windows (native) + WSL/Debian (openssl 3)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  // Supabase: DATABASE_URL = pooler (6543, pgbouncer=true), DIRECT_URL = direct (5432)
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  banned
}

enum OtpPurpose {
  register
  reset
}

enum PaymentKind {
  topup
  order
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
}

enum TokenTxType {
  purchase
  bid
  refund
  admin_adjust
}

enum AuctionStatus {
  draft
  scheduled
  live
  ended
  settled
  cancelled
}

enum OrderStatus {
  pending
  paid
  expired
  cancelled
}

/// Санал хүсэлтийн төрөл — хэрэглэгч юу хэлж байгаа вэ.
enum FeedbackType {
  bug         // Алдаа
  idea        // Шинэ санаа
  improvement // Сайжруулалт
  complaint   // Гомдол
  suggestion  // Санал
  praise      // Талархал
  other       // Бусад
}

/// Санал хүсэлтийн ангилал — аль хэсгийн тухай вэ.
enum FeedbackCategory {
  design      // Дизайн
  ux          // Хэрэглэгчийн туршлага
  performance // Хурд
  reliability // Ажиллагаа
  usability   // Үйлдэл
  content     // Агуулга
  billing     // Төлбөр тооцоо
  general     // Ерөнхий
}

enum FeedbackStatus {
  open
  reviewing
  resolved
  closed
}

model User {
  id           String     @id @default(uuid())
  phone        String     @unique
  name         String
  avatarUrl    String?    @map("avatar_url")
  passwordHash String     @map("password_hash")
  role         UserRole   @default(user)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  wallet        Wallet?
  bids          Bid[]
  transactions  TokenTransaction[]
  payments      Payment[]
  orders        Order[]
  devices       Device[]
  feedback      Feedback[]
  refreshTokens RefreshToken[]
  wonAuctions   Auction[]          @relation("LastBidder")
  createdAuctions Auction[]        @relation("CreatedBy")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String     @id @default(uuid())
  phone     String
  codeHash  String     @map("code_hash")
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at")
  attempts  Int        @default(0)
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

model Wallet {
  userId    String   @id @map("user_id")
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model TokenPackage {
  id       String  @id @default(uuid())
  tokens   Int
  priceMnt Int     @map("price_mnt")
  active   Boolean @default(true)
  sortOrder Int    @default(0) @map("sort_order")

  payments Payment[]

  @@map("token_packages")
}

model Payment {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  kind          PaymentKind
  packageId     String?       @map("package_id")
  orderId       String?       @unique @map("order_id")
  wireInvoiceId String?       @unique @map("wire_invoice_id")
  amountMnt     Int           @map("amount_mnt")
  status        PaymentStatus @default(pending)
  rawWebhook    Json?         @map("raw_webhook")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id])
  package TokenPackage? @relation(fields: [packageId], references: [id])
  order   Order?        @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@map("payments")
}

model TokenTransaction {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  amount    Int
  type      TokenTxType
  refId     String?     @map("ref_id")
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("token_transactions")
}

model Auction {
  id           String        @id @default(uuid())
  title        String
  description  String
  images       String[]
  startPrice   Int           @map("start_price")
  increment    Int
  softCloseSec Int           @map("soft_close_sec")
  extendSec    Int           @map("extend_sec")
  hardCloseAt  DateTime?     @map("hard_close_at")
  startsAt     DateTime      @map("starts_at")
  endsAt       DateTime      @map("ends_at")
  currentPrice Int           @map("current_price")
  bidCount     Int           @default(0) @map("bid_count")
  lastBidderId String?       @map("last_bidder_id")
  status       AuctionStatus @default(draft)
  createdById  String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  lastBidder User? @relation("LastBidder", fields: [lastBidderId], references: [id])
  createdBy  User  @relation("CreatedBy", fields: [createdById], references: [id])
  bids       Bid[]
  order      Order?

  @@index([status, endsAt])
  @@map("auctions")
}

model Bid {
  id        String   @id @default(uuid())
  auctionId String   @map("auction_id")
  userId    String   @map("user_id")
  price     Int
  createdAt DateTime @default(now()) @map("created_at")

  auction Auction @relation(fields: [auctionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([auctionId, createdAt])
  @@index([userId, createdAt])
  @@map("bids")
}

model Order {
  id            String      @id @default(uuid())
  auctionId     String      @unique @map("auction_id")
  winnerId      String      @map("winner_id")
  finalPrice    Int         @map("final_price")
  payDeadline   DateTime    @map("pay_deadline")
  status        OrderStatus @default(pending)
  deliveryInfo  Json?       @map("delivery_info")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  auction Auction  @relation(fields: [auctionId], references: [id])
  winner  User     @relation(fields: [winnerId], references: [id])
  payment Payment?

  @@map("orders")
}

model Device {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  fcmToken  String   @unique @map("fcm_token")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Feedback {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       FeedbackType
  category   FeedbackCategory
  message    String
  appVersion String?          @map("app_version")
  platform   String?
  status     FeedbackStatus   @default(open)
  adminNote  String?          @map("admin_note")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("feedback")
}

model AppContent {
  key       String   @id
  title     String
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_content")
}
