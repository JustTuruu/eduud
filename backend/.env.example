# --- Supabase Postgres ---
# Supabase Dashboard > Project Settings > Database > Connection string
# DATABASE_URL: "Transaction" pooler (порт 6543) + ?pgbouncer=true&connection_limit=10
# DIRECT_URL:   "Direct connection" (порт 5432) — зөвхөн prisma migrate ашиглана
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- JWT ---
JWT_ACCESS_SECRET="change-me-random-64-chars"
JWT_REFRESH_SECRET="change-me-another-random-64-chars"
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# --- OTP (verify.mn) ---
# OTP_PROVIDER: mock | verifymn  (mock үед код нь логт хэвлэгдэнэ, dev-д ашиглана)
OTP_PROVIDER=mock
VERIFYMN_API_URL="https://api.verify.mn"
VERIFYMN_API_KEY=""

# --- wire.mn payment gateway ---
# WIRE_MODE: test | live  (test үед invoice-г локал симуляци хийнэ)
WIRE_MODE=test
WIRE_API_URL="https://api.wire.mn"
WIRE_API_KEY=""
WIRE_WEBHOOK_SECRET=""

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="duud-media"
# Public bucket URL эсвэл custom domain (зураг үзүүлэхэд)
R2_PUBLIC_URL="https://media.example.mn"

# --- App ---
PORT=3000
# Ялагч төлбөрөө хийх хугацаа (цагаар)
ORDER_PAY_DEADLINE_HOURS=24
